[Unit]
Description=desktopctl desktop web server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/desktopctl/web
Environment=PORT=30080
ExecStart=/usr/bin/node /opt/desktopctl/web/node_modules/@orchael/desktopctl/server-dist/index.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
