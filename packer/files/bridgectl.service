[Unit]
Description=bridgectl agent server
After=network.target

[Service]
Type=simple
WorkingDirectory=/workspace
ExecStartPre=/bin/sh -c 'disp=$(ls /tmp/.X*-lock 2>/dev/null | sed "s|/tmp/.X||;s|-lock||" | sort -n | head -1); printf "DISPLAY=:%s\n" "$${disp:-1}" > %h/.config/bridgectl/display.env'
ExecStart=bridgectl server start --config %h/.config/bridgectl/config.yaml
EnvironmentFile=-%h/.config/bridgectl/agents.env
EnvironmentFile=-%h/.config/bridgectl/display.env
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=default.target
