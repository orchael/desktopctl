[Unit]
Description=bridgectl agent server
After=network.target

[Service]
Type=simple
WorkingDirectory=/workspace
ExecStartPre=/usr/local/bin/bridgectl-detect-display
ExecStart=bridgectl server start --config %h/.config/bridgectl/config.yaml
EnvironmentFile=-%h/.config/bridgectl/agents.env
EnvironmentFile=-%h/.config/environment.d/desktop-secrets.conf
EnvironmentFile=-%h/.config/bridgectl/display.env
KillMode=control-group
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=default.target
