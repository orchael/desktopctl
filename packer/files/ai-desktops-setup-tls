#!/bin/bash
# ai-desktops-setup-tls — configure TLS and nginx for the ai-desktops stack.
#
# Wraps novnc-setup-tls to obtain a Let's Encrypt certificate via DNS-01
# (Route53), then reconfigures nginx to serve:
#   /         → desktop-web React SPA (static files from /opt/ai-desktops/web/dist/)
#   /novnc/   → noVNC browser VNC client (proxied to upstream)
#   /api/     → ai-desktops Python API backend (127.0.0.1:3001)
#
# The EC2 instance must have an IAM role with Route53 permissions:
#   route53:ListHostedZones
#   route53:GetChange
#   route53:ChangeResourceRecordSets
#
# Usage (EC2 user-data or interactive):
#   export CERTBOT_DOMAIN=myapp.example.com
#   export CERTBOT_EMAIL=admin@example.com
#   sudo /usr/local/bin/ai-desktops-setup-tls
#
# Environment variables:
#   CERTBOT_DOMAIN        (required) Public domain pointing to this instance.
#   CERTBOT_EMAIL         Email for Let's Encrypt expiry notices.
#                         Default: admin@example.com
#   NOVNC_HTTP_PORT       HTTP port nginx listens on. Default: 8080
#   NOVNC_HTTPS_PORT      HTTPS port nginx listens on. Default: 8443
#   NOVNC_SERVICE         systemd meta-service name. Default: novnc-desktop
#   AI_DESKTOPS_WEB_PORT  Local port the ai-desktops web app listens on.
#                         Default: 3001

set -euo pipefail

export CERTBOT_DOMAIN="${CERTBOT_DOMAIN:-}"
export CERTBOT_EMAIL="${CERTBOT_EMAIL:-admin@example.com}"
export NOVNC_HTTP_PORT="${NOVNC_HTTP_PORT:-8080}"
export NOVNC_HTTPS_PORT="${NOVNC_HTTPS_PORT:-8443}"
export NOVNC_SERVICE="${NOVNC_SERVICE:-novnc-desktop}"
export AI_DESKTOPS_WEB_PORT="${AI_DESKTOPS_WEB_PORT:-3001}"

NGINX_SITE="/etc/nginx/sites-available/novnc"
LOG_FILE="/var/log/ai-desktops-setup-tls.log"

log() { echo "[$(date +'%Y-%m-%d %H:%M:%S')] $*" | tee -a "$LOG_FILE"; }
die() { log "ERROR: $*"; exit 1; }

[[ "$(id -u)" -eq 0 ]] || die "This script must be run as root"
[[ -n "$CERTBOT_DOMAIN" ]] || die "CERTBOT_DOMAIN is required"

log "=== ai-desktops-setup-tls starting ==="
log "Domain:       $CERTBOT_DOMAIN"
log "HTTP port:    $NOVNC_HTTP_PORT"
log "HTTPS port:   $NOVNC_HTTPS_PORT"
log "Web app port: $AI_DESKTOPS_WEB_PORT"

# --- Step 1: reconfigure nginx ports from AMI defaults (80/443) to runtime ports ---
# The novnc-desktop AMI is built with ports 80/443. ai-desktops runs on 8080/8443.
log "Reconfiguring nginx ports (80→${NOVNC_HTTP_PORT}, 443→${NOVNC_HTTPS_PORT})..."

python3 - <<PYEOF
import os, sys, re

nginx_site = "/etc/nginx/sites-available/novnc"
http_port  = os.environ["NOVNC_HTTP_PORT"]
https_port = os.environ["NOVNC_HTTPS_PORT"]
marker     = "# ai-desktops port reconfiguration"

with open(nginx_site) as fh:
    content = fh.read()

if marker in content:
    print("Port reconfiguration already applied — skipping")
    sys.exit(0)

# Replace listen 80 (HTTP redirect server) with the runtime HTTP port.
# Replace listen 443 ssl (HTTPS server) with the runtime HTTPS port.
content = re.sub(r'(\blisten\s+)80(\b)', r'\g<1>' + http_port + r'\2', content)
content = re.sub(r'(\blisten\s+)443(\s)', r'\g<1>' + https_port + r'\2', content)

# Inject marker at the top so the check above is reliable on re-runs.
content = "# " + marker + "\n" + content

with open(nginx_site, "w") as fh:
    fh.write(content)

print(f"Ports updated: 80->{http_port}, 443->{https_port} in {nginx_site}")
PYEOF

# Update UFW to allow the runtime ports.
ufw allow "${NOVNC_HTTP_PORT}/tcp" 2>/dev/null || true
ufw allow "${NOVNC_HTTPS_PORT}/tcp" 2>/dev/null || true

nginx -t 2>&1 | tee -a "$LOG_FILE"
systemctl reload nginx
log "nginx reloaded with updated ports"

# --- Step 2: obtain TLS certificate and wire it into novnc nginx -----------
# novnc-setup-tls uses the certbot dns-route53 plugin (DNS-01), so port 80
# does not need to be publicly accessible.
log "Running novnc-setup-tls..."
/usr/local/bin/novnc-setup-tls

# --- Step 3: reconfigure nginx to serve desktop-web and proxy noVNC/API ----
# The novnc-desktop nginx config has "location / { proxy_pass noVNC; }".
# We need to:
#   1. Rename that block to "location /novnc/" so noVNC moves under /novnc/.
#   2. Add "location / { try_files ... }" to serve the React SPA.
#   3. Add "location /api/ { proxy_pass ... }" for the Python API backend.
log "Reconfiguring nginx locations for desktop-web (static + /novnc/ + /api/)..."

python3 - <<'PYEOF'
import os, sys, re

nginx_site = "/etc/nginx/sites-available/novnc"
web_port   = os.environ["AI_DESKTOPS_WEB_PORT"]
marker     = "# ai-desktops location reconfiguration"
anchor     = "  location @unauthorized {"

with open(nginx_site) as fh:
    content = fh.read()

if marker in content:
    print("ai-desktops location reconfiguration already applied — skipping")
    sys.exit(0)

if anchor not in content:
    print(f"ERROR: expected anchor '{anchor}' not found in {nginx_site}", file=sys.stderr)
    sys.exit(1)

# --- Part A: rename "location / { ... proxy_pass http://127.0.0.1:6080/ ... }"
#             to "location /novnc/ { ... }" so noVNC lives under /novnc/.
def find_location_block(text, path, required_content):
    """Return (start, end) byte range of 'location <path> { ... }' containing required_content."""
    pattern = re.compile(r'(\blocation\s+' + re.escape(path) + r'\s*\{)')
    for m in pattern.finditer(text):
        brace_pos = m.end() - 1  # position of opening {
        depth = 0
        i = brace_pos
        while i < len(text):
            if text[i] == '{':
                depth += 1
            elif text[i] == '}':
                depth -= 1
                if depth == 0:
                    block = text[m.start():i + 1]
                    if required_content in block:
                        return m.start(), i + 1
                    break
            i += 1
    return None, None

loc_start, loc_end = find_location_block(content, '/', 'proxy_pass http://127.0.0.1:6080/')
if loc_start is None:
    print("ERROR: could not find 'location / { ... proxy_pass http://127.0.0.1:6080/ ... }' block",
          file=sys.stderr)
    sys.exit(1)

novnc_block = content[loc_start:loc_end]
novnc_block = re.sub(r'\blocation\s+/\s*\{', 'location /novnc/ {', novnc_block, count=1)
content = content[:loc_start] + novnc_block + content[loc_end:]

# --- Part B: insert root, index, location /, and location /api/ before @unauthorized.
spa_block = f"""
  {marker}

  # Serve the desktop-web React SPA.
  root /opt/ai-desktops/web/dist;
  index index.html;

  location / {{
    try_files $uri $uri/ /index.html;
  }}

  # noVNC WebSocket — the browser client connects here for the VNC session.
  # noVNC defaults to /websockify (absolute path) regardless of page path,
  # so this must be a top-level location rather than living under /novnc/.
  location /websockify {{
    auth_request /_auth/verify;
    error_page 401 = @unauthorized;

    proxy_pass http://127.0.0.1:6080/websockify;
    proxy_http_version 1.1;
    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host       $host;
    proxy_read_timeout 24h;
    proxy_send_timeout 24h;
  }}

  # novnc-auth redirects to /vnc.html after a successful token exchange
  # (DEFAULT_REDIRECT in novnc-auth.py). Forward that to /novnc/ where
  # noVNC now lives, preserving any query string.
  location = /vnc.html {{
    return 301 /novnc/vnc.html$is_args$args;
  }}

  # Proxy the ai-desktops API backend.
  location /api/ {{
    proxy_pass         http://127.0.0.1:{web_port}/api/;
    proxy_http_version 1.1;
    proxy_set_header   Host              $host;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_set_header   X-Forwarded-Host  $host;
  }}

"""

content = content.replace(anchor, spa_block + anchor, 1)

with open(nginx_site, "w") as fh:
    fh.write(content)

print(f"Reconfigured nginx: /novnc/ proxies to noVNC, / serves React SPA, /api/ proxies to port {web_port}")
PYEOF

nginx -t 2>&1 | tee -a "$LOG_FILE"
systemctl reload nginx
log "nginx reloaded"

# --- Done ------------------------------------------------------------------
DOMAIN_WITH_PORT="$CERTBOT_DOMAIN"
[[ "$NOVNC_HTTPS_PORT" != "443" ]] && DOMAIN_WITH_PORT="${CERTBOT_DOMAIN}:${NOVNC_HTTPS_PORT}"

log "=== ai-desktops-setup-tls complete ==="
log "Desktop:  https://${DOMAIN_WITH_PORT}/"
log "noVNC:    https://${DOMAIN_WITH_PORT}/novnc/vnc.html"
log "API:      https://${DOMAIN_WITH_PORT}/api/desktop"
log ""
log "Run: sudo novnc-desktop-url"
log "     to get a signed HTTPS access URL."
