[Unit]
Description=ai-desktops desktop web server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/ai-desktops/web
Environment=PORT=30080
ExecStart=/usr/bin/node /opt/ai-desktops/web/node_modules/@markcallen/desktop-web/server-dist/index.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
