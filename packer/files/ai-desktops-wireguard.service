[Unit]
Description=AI Desktops WireGuard VPN setup
After=cloud-init.target network-online.target
Wants=network-online.target
ConditionPathExists=/opt/ai-desktops/desktop.env

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/ai-desktops-wireguard-setup

[Install]
WantedBy=cloud-init.target
