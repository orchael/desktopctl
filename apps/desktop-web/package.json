{
  "name": "@markcallen/desktop-web",
  "version": "0.6.1",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "main": "server-dist/index.js",
  "bin": {
    "desktop-web": "server-dist/index.js"
  },
  "files": [
    "dist",
    "server-dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "vite": "vite",
    "dev": "tsx server/index.ts & SRV=$!; vite; kill $SRV 2>/dev/null; wait $SRV 2>/dev/null",
    "dev:mock": "MOCK=true tsx server/index.ts & SRV=$!; vite; kill $SRV 2>/dev/null; wait $SRV 2>/dev/null",
    "api": "tsx server/index.ts",
    "api:mock": "MOCK=true tsx server/index.ts",
    "build": "tsc && vite build && tsc -p tsconfig.server.json",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node server-dist/index.js",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier . --check",
    "prettier:fix": "prettier . --write",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "playwright test"
  },
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "pnpm": {
    "allowedDeprecatedVersions": {},
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.7",
    "supertest": "^7.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
