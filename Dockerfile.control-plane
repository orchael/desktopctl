FROM node:22.13.0-bookworm-slim AS web-dependencies
WORKDIR /src/apps/control-plane-web
RUN npm install -g pnpm@10.27.0
COPY apps/control-plane-web/package.json apps/control-plane-web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

FROM web-dependencies AS web-dev
COPY apps/control-plane-web/ ./
EXPOSE 3000
CMD ["pnpm", "run", "dev"]

FROM web-dev AS web-build
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm run build

FROM node:22.13.0-bookworm-slim AS web
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
COPY --from=web-build /src/apps/control-plane-web/.next/standalone ./
COPY --from=web-build /src/apps/control-plane-web/.next/static ./.next/static
COPY --from=web-build /src/apps/control-plane-web/package.json ./apps/control-plane-web/package.json
COPY --from=web-build /src/apps/control-plane-web/node_modules ./apps/control-plane-web/node_modules
EXPOSE 3000
USER node
CMD ["node", "server.js"]

FROM golang:1.26-bookworm AS api-build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ ./cmd/
COPY internal/ ./internal/
RUN --mount=type=cache,target=/root/.cache/go-build go build -o /out/control-plane ./cmd/control-plane && go build -o /out/desktopctl ./cmd/desktopctl

FROM pulumi/pulumi-go:3.243.0 AS api
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates wget && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=api-build /out/control-plane /app/control-plane
COPY --from=api-build /out/desktopctl /app/desktopctl
ENV CONTROL_PLANE_ADDR=:8080
EXPOSE 8080
USER 65532:65532
ENTRYPOINT ["/app/control-plane"]

FROM debian:bookworm-slim AS api-dev
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates wget && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=api-build /out/control-plane /app/control-plane
COPY --chown=65532:65532 config.example.yaml /app/config.example.yaml
ENV DESKTOPCTL_CONFIG=/app/config.example.yaml CONTROL_PLANE_MOCK_AWS=true
EXPOSE 8080
USER 65532:65532
ENTRYPOINT ["/app/control-plane"]
