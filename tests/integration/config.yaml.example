# Integration test configuration template.
# Copy to tests/integration/config.yaml and fill in your values.
# tests/integration/config.yaml is gitignored — never commit it.
#
# To generate this file interactively, run:
#   make setup-integration
#
# Required env var alternatives (if you prefer not to run setup):
#   DESKTOPCTL_TEST_BUCKET   — S3 bucket name (passed to test-integration)
#   DESKTOPCTL_GITHUB_OWNER  — GitHub org or user

aws:
  # AWS region where the integration test resources are provisioned.
  # Region assignments: us-east-1 = prod, us-east-2 = dev, us-west-2 = test
  region: us-west-2

  # AWS CLI profile to use. Leave blank to use the default credential chain.
  profile: ""

pulumi:
  # S3 bucket for Pulumi state. Must be globally unique.
  # Created by `desktopctl bootstrap` (or make setup-integration).
  backend_bucket: myorg-desktopctl-test

  # Absolute path to the repo root (contains infra/pulumi/foundation, etc.).
  # Set automatically by make setup-integration; edit if running manually.
  infra_dir: /path/to/desktopctl

fleet:
  # Use a dedicated test fleet table so integration tests never touch the
  # production fleet records.
  table_name: desktopctl-fleet-test-us-west-2
  ami_table_name: desktopctl-ami-test-us-west-2

  # test environment uses the dev DNS zone (desktops.orchael.dev).
  environment: test

github:
  owner: myorg

  # AWS Secrets Manager secret path created by `desktopctl setup`.
  # Contains github_token, ssh_private_key, and ssh_public_key as JSON.
  github_secret: /desktopctl/test/us-west-2/myorg/github

  # Agent API keys secret path created by `desktopctl setup`.
  agent_secret: /desktopctl/test/us-west-2/myorg/agents

  # Git identity written to the desktop's global git config.
  git_user_name: Your Name
  git_user_email: you@example.com

desktop:
  instance_type: t3.large
  volume_size: 100
  operator_cidr: 0.0.0.0/0

  # SSH key used to access test desktops.
  # Point to tests/integration/id_ed25519 (generated by make setup-integration)
  # or any other key whose public half is registered in EC2.
  ssh_key_path: /path/to/desktopctl/tests/integration/id_ed25519
  ssh_key_name: desktopctl-myorg

agent:
  bridge_port: 9445
